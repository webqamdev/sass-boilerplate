{
  "name": "@webqamdev/sass-boilerplate",
  "author": "Webqam",
  "version": "1.0.0",
  "description": "Webqam's SCSS boilerplate",
  "keywords": [
    "sass",
    "scss",
    "boilerplate"
  ],
  "homepage": "https://github.com/webqamdev/sass-boilerplate",
  "bugs": {
    "url": "https://github.com/webqamdev/sass-boilerplate/issues"
  },
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/webqamdev/sass-boilerplate"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run lint",
    "lint": "npm run eslint && npm run prettier && npm run stylelint",
    "lint:fix": "npm run eslint:fix && npm run prettier:fix && npm run stylelint:fix",
    "prettier": "npm run prettier:config -- --check",
    "prettier:config": "prettier --ignore-path .gitignore '{**/*,*}.{md,scss,sass,css,js,ts}'",
    "prettier:fix": "npm run prettier:config -- --write",
    "eslint": "eslint --ignore-path .gitignore '{**/*,*}.{js,ts}'",
    "eslint:fix": "npm run eslint -- --fix",
    "stylelint": "stylelint --ignore-path .gitignore '{**/*,*}.{scss,sass,css}'",
    "stylelint:fix": "npm run stylelint -- --fix"
  },
  "devDependencies": {
    "sass": "^1.69.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "normalize.css": "^8.0.1"
  },
  "volta": {
    "node": "20.10.0"
  }
}
